{
  "name": "360simulator-cli",
  "version": "1.0.0",
  "description": "360模拟器 CLI Agent 接口 - JSON-lines over stdin/stdout",
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc --noEmit && esbuild src/main.ts --bundle --platform=node --format=esm --target=node22 --outfile=dist/main.js --tsconfig=tsconfig.json",
    "start": "node dist/main.js",
    "dev": "tsx src/main.ts",
    "agent-test:baseline": "node agent-tests/baseline.mjs",
    "agent-test:phase1": "node agent-tests/phase1_pace.mjs",
    "agent-test:phase2": "node agent-tests/phase2_feedback.mjs",
    "agent-test:phase3": "node agent-tests/phase3_drama.mjs",
    "agent-test:phase4": "node agent-tests/phase4_replay.mjs",
    "agent-test:phase5": "node agent-tests/phase5_ui.mjs",
    "agent-test:phase6": "node agent-tests/phase6_balance.mjs"
  },
  "dependencies": {
    "tsx": "^4.19.0"
  },
  "devDependencies": {
    "typescript": "~5.9.3",
    "esbuild": "~0.27.0",
    "@types/node": "^22.0.0"
  }
}
