# ============ LLM 配置（服务端私有，不会暴露到前端） ============
# 复制此文件为 .env 并按需填写。
#
# 【强烈推荐：默认不配 LLM_API_KEY（零成本形态）】
#   不设 key 时，前端"赛博勇哥"自动走【规则版】——完全本地、零网络、永不报错、人人可用，
#   作者一分钱不花。上千用户无 key 也能正常诊断。这是上线发小红书的安全默认。
#
#   想用真 AI？让用户在前端"接入我的AI"里填【他们自己的】key（BYOK），自付费、不烧你的钱。
#
# 【仅当你想自掏腰包托管 AI 勇哥时，才取消下面注释并配 key】
#   托管 = 烧钱路径，务必同时设 LLM_DAILY_BUDGET 防被刷爆！

# LLM_BASE_URL=https://api.openai.com
# LLM_API_KEY=your-api-key-here
# LLM_MODEL=gpt-5.2

# 备选：Moonshot (Kimi)
# LLM_BASE_URL=https://api.moonshot.cn
# LLM_API_KEY=your-moonshot-key-here
# LLM_MODEL=kimi-k2-turbo-preview

# 备选：Google Gemini
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# LLM_API_KEY=your-gemini-key-here
# LLM_MODEL=gemini-3-flash

# ============ 防烧钱 / 部署加固（配了 LLM_API_KEY 才有意义） ============

# 全局每日请求上限（内存计数，进程重启清零）。超限返回友好 429，引导用户接入自己的 key。
# 默认 200。设 0 或负数 = 不限制（公网部署强烈不推荐）。BYOK 用户自付，不计入此额度。
# LLM_DAILY_BUDGET=200

# 单 IP 每分钟请求上限（限速 key 用真实 socket 地址，不信任可伪造的 X-Forwarded-For）。默认 30。
# LLM_PROXY_RATE_LIMIT=30

# 上游 LLM 请求超时（毫秒），防止慢响应挂住连接。默认 30000。
# LLM_UPSTREAM_TIMEOUT_MS=30000

# 鉴权 token（公网托管时强烈建议设置）。设了之后只有带 Authorization: Bearer <token> 的
# 非 BYOK 请求才放行；前端默认不带 token，即匿名公网请求会被 403（有意为之，避免裸奔）。
# LLM_PROXY_TOKEN=

# 本地 loopback 放行开关（仅本地开发用）。当配置了 LLM_API_KEY 且未设 LLM_PROXY_TOKEN 时，
# 默认【拒绝】所有请求——因为反向代理(Nginx)后 socket 地址恒为 127.0.0.1，匿名外部请求会被
# 误判为本机而烧你的 key。本地开发想直接用作者 key 调试，再显式设为 true。生产请勿开启。
# LLM_ALLOW_LOCAL_LLM_PROXY=false

# ============ 网络绑定 ============
# 默认 127.0.0.1（仅本机）。公网部署需 HOST=0.0.0.0，并务必知悉上面的鉴权/预算方案。
# HOST=127.0.0.1
# PORT=10041
